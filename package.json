{
  "name": "@sofiakb/nemaaz",
  "version": "1.0.3-dev.0",
  "description": "A typescript library to compute Islamic prayer times.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "jest",
    "clean": "rm -rf lib",
    "build": "pnpm run clean && tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --quiet --fix",
    "prepare": "pnpm run lint && pnpm run format && pnpm run build",
    "prepublishOnly": "pnpm run lint",
    "release": "./scripts/release.sh",
    "preversion": "pnpm run test && pnpm run lint",
    "version": "pnpm run build && pnpm run format && git add -A package.json src && git commit -m \"Bump version to $(cat package.json | jq -r '.version')\"",
    "postversion": "git push -u origin HEAD --tags && ./scripts/release.sh $(cat package.json | jq -r '.version')"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sofiakb/nemaaz.git"
  },
  "author": {
    "name": "Sofiakb",
    "email": "<contact.sofiakb@gmail.com>",
    "url": "https://sofianeakbly.fr"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sofiakb/nemaaz/issues"
  },
  "homepage": "https://github.com/sofiakb/nemaaz#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.4",
    "@types/node": "^24.13.3",
    "babel-jest": "^30.4.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "moment": "^2.30.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "files": [
    "lib/**/*"
  ],
  "dependencies": {
    "luxon": "^3.7.2"
  }
}
